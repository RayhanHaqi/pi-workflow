{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_baseline_runtime_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_baseline_runtime_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "baseline_mode": {
      "type": "string",
      "enum": [
        "CLEAN_REQUIRED",
        "APPROVED_BASELINE_DIRTY"
      ]
    },
    "repository": {
      "$ref": "https://pi-gacw.invalid/schemas/pi_gacw_repository_identity_v0.schema.json"
    },
    "git_fingerprint": {
      "$ref": "https://pi-gacw.invalid/schemas/pi_gacw_git_state_fingerprint_v0.schema.json"
    },
    "accepted_baseline": {
      "$ref": "https://pi-gacw.invalid/schemas/pi_gacw_baseline_v0.schema.json"
    },
    "instruction_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "real_path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "mode": {
                "minimum": 0,
                "maximum": 4095,
                "type": "integer"
              },
              "size": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "content_sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "real_path",
              "mode",
              "size",
              "content_sha256"
            ]
          }
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "content_sha256"
      ]
    },
    "authority_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "real_path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "mode": {
                "minimum": 0,
                "maximum": 4095,
                "type": "integer"
              },
              "size": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "content_sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "real_path",
              "mode",
              "size",
              "content_sha256"
            ]
          }
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "content_sha256"
      ]
    },
    "paths": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 4096,
            "type": "string"
          },
          "ownership_class": {
            "type": "string",
            "enum": [
              "OWNER_AUTHORITY",
              "OWNER_ACCEPTED_MUTABLE",
              "PREEXISTING_UNRELATED",
              "GENERATED_ACCEPTED_BASELINE"
            ]
          },
          "data_class": {
            "type": "string",
            "enum": [
              "PUBLIC_SOURCE",
              "PRIVATE_SOURCE",
              "SENSITIVE",
              "SECRET",
              "LARGE_BINARY",
              "HASH_ONLY"
            ]
          },
          "capture_mode": {
            "type": "string",
            "enum": [
              "HASH_ONLY",
              "BLOB"
            ]
          },
          "explicit_blob_approval": {
            "type": "boolean"
          },
          "retention_days_after_terminal": {
            "anyOf": [
              {
                "minimum": 1,
                "maximum": 30,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "REGULAR",
              "DELETED"
            ]
          },
          "mode": {
            "anyOf": [
              {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "size": {
            "anyOf": [
              {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "status_sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "blob": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "blob_sha256": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "byte_length": {
                    "minimum": 0,
                    "maximum": 1048576,
                    "type": "integer"
                  },
                  "relative_path": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "required": [
                  "blob_sha256",
                  "byte_length",
                  "relative_path"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "ownership_class",
          "data_class",
          "capture_mode",
          "explicit_blob_approval",
          "retention_days_after_terminal",
          "content_sha256",
          "file_type",
          "mode",
          "size",
          "status_sha256",
          "blob"
        ]
      }
    },
    "blob_quota": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "logical_approved_bytes": {
          "minimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "physical_bytes": {
          "minimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "deduplicated_bytes": {
          "minimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "existing_physical_bytes": {
          "minimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "new_unique_physical_bytes": {
          "minimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "resulting_physical_bytes": {
          "minimum": 0,
          "maximum": 67108864,
          "type": "integer"
        }
      },
      "required": [
        "logical_approved_bytes",
        "physical_bytes",
        "deduplicated_bytes",
        "existing_physical_bytes",
        "new_unique_physical_bytes",
        "resulting_physical_bytes"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "run_id",
    "baseline_mode",
    "repository",
    "git_fingerprint",
    "accepted_baseline",
    "instruction_fingerprint",
    "authority_fingerprint",
    "paths",
    "blob_quota"
  ]
}
