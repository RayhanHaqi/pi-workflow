{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_state_transition_commit_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_state_transition_commit_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "commit_protocol_version": {
      "const": "state-commit-v1",
      "type": "string"
    },
    "commit_kind": {
      "type": "string",
      "enum": [
        "GENESIS",
        "TRANSITION",
        "PROCESS_CRASH"
      ]
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "transition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "previous_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 9007199254740990,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "new_revision": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "previous_state_pointer_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_workflow_state_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_transition_commit_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "transition_event_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reducer_policy_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "new_workflow_state_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_manifest_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "process_assessment_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_metadata": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "controller_instance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "process_id": {
          "minimum": 1,
          "maximum": 2147483647,
          "type": "integer"
        },
        "invocation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "controller_instance_id",
        "process_id",
        "invocation_id"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "commit_protocol_version",
    "commit_kind",
    "run_id",
    "transition_id",
    "previous_revision",
    "new_revision",
    "previous_state_pointer_content_sha256",
    "previous_workflow_state_content_sha256",
    "previous_transition_commit_content_sha256",
    "transition_event_content_sha256",
    "reducer_policy_content_sha256",
    "new_workflow_state_content_sha256",
    "evidence_manifest_content_sha256",
    "process_assessment_content_sha256",
    "process_metadata"
  ]
}
