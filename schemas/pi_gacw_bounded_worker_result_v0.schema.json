{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_bounded_worker_result_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_bounded_worker_result_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "invocation_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "const": "COMPLETED",
          "type": "string"
        },
        {
          "const": "BLOCKED",
          "type": "string"
        }
      ]
    },
    "first_failure_code": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_failure_stage": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_failure_message": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "m3_evidence_content_sha256": {
      "uniqueItems": true,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      }
    },
    "m4_evidence_content_sha256": {
      "uniqueItems": true,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      }
    },
    "actual_usage": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "worker_invocations": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "m4_tool_calls": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "model_turns": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_requests": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_microusd": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_time_ms": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "worker_invocations",
        "m4_tool_calls",
        "model_turns",
        "provider_requests",
        "input_tokens",
        "output_tokens",
        "cost_microusd",
        "wall_time_ms"
      ]
    },
    "cleanup_certain": {
      "type": "boolean"
    },
    "advisory_report": {
      "anyOf": [
        {
          "maxLength": 8192,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "invocation_content_sha256",
    "outcome",
    "first_failure_code",
    "first_failure_stage",
    "m3_evidence_content_sha256",
    "m4_evidence_content_sha256",
    "actual_usage",
    "cleanup_certain",
    "advisory_report",
    "completed_at"
  ]
}
