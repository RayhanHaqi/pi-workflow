{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_m6_worker_result_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_m6_worker_result_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "invocation_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "invocation_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "const": "COMPLETED",
          "type": "string"
        },
        {
          "const": "BLOCKED",
          "type": "string"
        }
      ]
    },
    "provider_work_started": {
      "type": "boolean"
    },
    "first_failure_code": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_failure_stage": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_report": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "status": {
              "const": "COMPLETED",
              "type": "string"
            },
            "summary": {
              "minLength": 1,
              "maxLength": 2048,
              "type": "string"
            },
            "evidence_content_sha256": {
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "summary",
            "evidence_content_sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "m4_result_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "provider_turns": {
          "minimum": 0,
          "maximum": 2,
          "type": "integer"
        },
        "model_turns": {
          "minimum": 0,
          "maximum": 2,
          "type": "integer"
        },
        "provider_requests": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_calls": {
          "minimum": 0,
          "maximum": 2,
          "type": "integer"
        },
        "read_calls": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "report_submissions": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_microusd": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "maximum": 120000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider_turns",
        "model_turns",
        "provider_requests",
        "tool_calls",
        "read_calls",
        "report_submissions",
        "input_tokens",
        "output_tokens",
        "cost_microusd",
        "wall_time_ms"
      ]
    },
    "settlement": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "prompt_settled": {
          "type": "boolean"
        },
        "agent_idle": {
          "type": "boolean"
        },
        "pending_tool_calls": {
          "minimum": 0,
          "maximum": 2,
          "type": "integer"
        },
        "subscriber_removed": {
          "type": "boolean"
        },
        "queues_empty": {
          "type": "boolean"
        },
        "reset_completed": {
          "type": "boolean"
        },
        "timers_cleared": {
          "type": "boolean"
        },
        "provider_collection_cleared": {
          "type": "boolean"
        },
        "owned_provider_streams": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "owned_child_processes": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "owned_sockets": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "owned_fifos": {
          "minimum": 0,
          "maximum": 1,
          "type": "integer"
        },
        "cleanup_certain": {
          "type": "boolean"
        }
      },
      "required": [
        "prompt_settled",
        "agent_idle",
        "pending_tool_calls",
        "subscriber_removed",
        "queues_empty",
        "reset_completed",
        "timers_cleared",
        "provider_collection_cleared",
        "owned_provider_streams",
        "owned_child_processes",
        "owned_sockets",
        "owned_fifos",
        "cleanup_certain"
      ]
    },
    "cleanup_failure_code": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "invocation_key",
    "invocation_content_sha256",
    "run_id",
    "outcome",
    "provider_work_started",
    "first_failure_code",
    "first_failure_stage",
    "worker_report",
    "m4_result_content_sha256",
    "usage",
    "settlement",
    "cleanup_failure_code",
    "completed_at"
  ]
}
