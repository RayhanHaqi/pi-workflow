{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_preflight_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_preflight_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "preflight_kind": {
      "type": "string",
      "enum": [
        "FULL",
        "FAST"
      ]
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "prior_token_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "$ref": "https://pi-gacw.invalid/schemas/pi_gacw_repository_identity_v0.schema.json"
    },
    "worktree_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "lock_diagnostic_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "baseline_runtime_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "baseline_snapshot_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "baseline_approval_runtime_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "git_fingerprint": {
      "$ref": "https://pi-gacw.invalid/schemas/pi_gacw_git_state_fingerprint_v0.schema.json"
    },
    "instruction_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "real_path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "mode": {
                "minimum": 0,
                "maximum": 4095,
                "type": "integer"
              },
              "size": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "content_sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "real_path",
              "mode",
              "size",
              "content_sha256"
            ]
          }
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "content_sha256"
      ]
    },
    "authority_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "real_path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "mode": {
                "minimum": 0,
                "maximum": 4095,
                "type": "integer"
              },
              "size": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "content_sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "real_path",
              "mode",
              "size",
              "content_sha256"
            ]
          }
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "content_sha256"
      ]
    },
    "environment_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "node_version": {
          "minLength": 1,
          "maxLength": 255,
          "type": "string"
        },
        "git_version": {
          "minLength": 1,
          "maxLength": 255,
          "type": "string"
        },
        "python_version": {
          "minLength": 1,
          "maxLength": 255,
          "type": "string"
        },
        "controller_version": {
          "const": "0.1.0",
          "type": "string"
        },
        "node_path": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "git_path": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "python_path": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "guardian_helper_path": {
          "minLength": 1,
          "maxLength": 4096,
          "type": "string"
        },
        "guardian_helper_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "node_version",
        "git_version",
        "python_version",
        "controller_version",
        "node_path",
        "git_path",
        "python_path",
        "guardian_helper_path",
        "guardian_helper_sha256",
        "content_sha256"
      ]
    },
    "task_scope_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "result": {
      "const": "PASS",
      "type": "string"
    },
    "blockers": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 255,
        "type": "string"
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "preflight_kind",
    "run_id",
    "prior_token_content_sha256",
    "repository",
    "worktree_key",
    "lock_diagnostic_content_sha256",
    "baseline_runtime_content_sha256",
    "baseline_snapshot_sha256",
    "baseline_approval_runtime_content_sha256",
    "git_fingerprint",
    "instruction_fingerprint",
    "authority_fingerprint",
    "environment_fingerprint",
    "task_scope_identity",
    "result",
    "blockers"
  ]
}
