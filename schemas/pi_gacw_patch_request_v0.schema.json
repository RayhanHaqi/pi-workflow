{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_patch_request_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_patch_request_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "requested_at": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    },
    "repository_identity_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "worktree_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "lock_acquisition_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "prior_state_token_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_scope_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tool_policy_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "secure_fs_capability_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "CREATE",
        "REPLACE",
        "DELETE"
      ]
    },
    "path": {
      "minLength": 1,
      "maxLength": 4096,
      "type": "string"
    },
    "ownership_class": {
      "type": "string",
      "enum": [
        "OWNER_AUTHORITY",
        "OWNER_ACCEPTED_MUTABLE",
        "PREEXISTING_UNRELATED",
        "GENERATED_ACCEPTED_BASELINE"
      ]
    },
    "data_class": {
      "type": "string",
      "enum": [
        "PUBLIC_SOURCE",
        "PRIVATE_SOURCE",
        "SENSITIVE",
        "SECRET",
        "LARGE_BINARY",
        "HASH_ONLY"
      ]
    },
    "expected_preimage_exists": {
      "type": "boolean"
    },
    "expected_preimage_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_preimage_size": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_preimage_mode": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement_byte_count": {
      "minimum": 0,
      "maximum": 1048576,
      "type": "integer"
    },
    "requested_final_mode": {
      "anyOf": [
        {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "patch_format_identity": {
      "const": "exact-bytes-v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "run_id",
    "requested_at",
    "repository_identity_content_sha256",
    "worktree_key",
    "lock_acquisition_content_sha256",
    "prior_state_token_content_sha256",
    "task_scope_identity",
    "tool_policy_content_sha256",
    "secure_fs_capability_content_sha256",
    "operation",
    "path",
    "ownership_class",
    "data_class",
    "expected_preimage_exists",
    "expected_preimage_digest",
    "expected_preimage_size",
    "expected_preimage_mode",
    "replacement_digest",
    "replacement_byte_count",
    "requested_final_mode",
    "patch_format_identity"
  ]
}
