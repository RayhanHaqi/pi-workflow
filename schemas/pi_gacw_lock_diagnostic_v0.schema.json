    "schema_version",
    "content_projection_id",
    "content_sha256",
    "lock_acquisition_content_sha256",
    "state_root",
    "protocol_version",
    "worktree_key",
    "worktree_root",
    "git_common_dir",
    "lock_path",
    "owner_marker_path",
    "guardian_python_invocation_path",
    "guardian_python_realpath",
    "guardian_python_path",
    "guardian_python_version",
    "guardian_helper_path",
    "guardian_helper_realpath",
    "guardian_helper_sha256",
    "controller_pid",
    "guardian_pid",
    "acquired_at",
    "acquisition_nonce",
