            "atomic_rename_attempted": {
              "type": "boolean"
            },
            "atomic_rename_completed": {
              "type": "boolean"
            },
            "directory_fsync_attempt_count": {
              "minimum": 0,
              "maximum": 8,
              "type": "integer"
            },
            "directory_fsync_completed_count": {
              "minimum": 0,
              "maximum": 8,
              "type": "integer"
            },
            "preimage_validation": {
              "type": "string",
              "enum": [
                "NOT_RUN",
                "PASS",
                "FAIL"
              ]
            },
            "rollback_required": {
              "type": "boolean"
            },
            "rollback_attempted": {
              "type": "boolean"
            },
            "rollback_completed": {
              "type": "boolean"
            },
            "rollback_directory_fsync_completed": {
              "type": "boolean"
            },
            "final_verification": {
              "type": "string",
              "enum": [
                "NOT_RUN",
                "PASS",
                "FAIL"
              ]
            },
            "operation_nonce": {
              "anyOf": [
                {
                  "pattern": "^[0-9a-f]{32}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "temporary_device": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "temporary_inode": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "temporary_nlink": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tombstone_created": {
              "type": "boolean"
            },
            "tombstone_device": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tombstone_inode": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tombstone_nlink": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "preimage_device": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "preimage_inode": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "preimage_nlink": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recovery_attempted": {
              "type": "boolean"
            },
            "recovery_outcome": {
              "type": "string",
              "enum": [
                "NOT_RUN",
                "SUCCEEDED",
                "FAILED",
                "IDENTITY_MISMATCH"
              ]
            },
            "recovery_residue_count": {
              "anyOf": [
                {
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recovery_target_verification": {
              "type": "string",
              "enum": [
                "NOT_RUN",
                "ABSENT",
                "PREIMAGE",
                "REPLACEMENT",
                "MISMATCH",
                "UNKNOWN"
              ]
            },
            "recovery_directory_fsync": {
              "type": "string",
              "enum": [
                "NOT_RUN",
                "SUCCEEDED",
                "FAILED"
              ]
            },
            "recovery_helper_sha256": {
              "anyOf": [
                {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "temporary_file_created",
            "temporary_bytes_written",
            "temporary_file_fsync_attempted",
            "temporary_file_fsync_completed",
            "atomic_operation",
            "atomic_rename_attempted",
            "atomic_rename_completed",
            "directory_fsync_attempt_count",
            "directory_fsync_completed_count",
            "preimage_validation",
            "rollback_required",
            "rollback_attempted",
            "rollback_completed",
            "rollback_directory_fsync_completed",
            "final_verification"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    }
