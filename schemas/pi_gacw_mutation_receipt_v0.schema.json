    "file_fsync": {
      "type": "boolean"
    },
    "atomic_rename": {
      "type": "boolean"
    },
    "directory_fsync": {
      "type": "boolean"
    },
    "rollback_outcome": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "postflight_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_code": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "helper_journal": {
