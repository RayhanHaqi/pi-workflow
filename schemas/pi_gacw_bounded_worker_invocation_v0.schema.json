{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_bounded_worker_invocation_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_bounded_worker_invocation_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "invocation_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "m5_reservation_decision_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "m5_reservation_decision_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_graph_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_approval_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_m3_state_token_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "system_prompt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "user_prompt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "invocation_key",
    "run_id",
    "operation_id",
    "m5_reservation_decision_content_sha256",
    "m5_reservation_decision_key",
    "task_content_sha256",
    "task_graph_sha256",
    "plan_approval_sha256",
    "input_m3_state_token_content_sha256",
    "system_prompt_sha256",
    "user_prompt_sha256",
    "created_at"
  ]
}
