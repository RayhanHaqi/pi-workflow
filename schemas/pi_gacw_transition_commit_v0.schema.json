{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_transition_commit_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_transition_commit_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "transition_commit_projection_id": {
      "const": "transition-commit-v1",
      "type": "string"
    },
    "transition_commit_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "from_state_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "event_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "to_state_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_sha256": {
      "maxItems": 100000,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "transition_commit_projection_id",
    "transition_commit_sha256",
    "sequence",
    "from_state_sha256",
    "event_sha256",
    "to_state_sha256",
    "evidence_sha256"
