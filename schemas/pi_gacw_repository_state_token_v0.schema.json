{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_repository_state_token_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_repository_state_token_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "FULL_PREFLIGHT",
        "RESUME_LOCK_HANDOVER",
        "POSTFLIGHT"
      ]
    },
    "source_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "prior_token_content_sha256": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "type": "string"
    },
    "repository_identity_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "worktree_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "branch": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "head": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "worktree_list_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "git_fingerprint": {
      "$ref": "https://pi-gacw.invalid/schemas/pi_gacw_git_state_fingerprint_v0.schema.json"
    },
    "instruction_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "real_path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "mode": {
                "minimum": 0,
                "maximum": 4095,
                "type": "integer"
              },
              "size": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "content_sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "real_path",
              "mode",
              "size",
              "content_sha256"
            ]
          }
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "content_sha256"
      ]
    },
    "authority_fingerprint": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "entries": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "real_path": {
                "minLength": 1,
                "maxLength": 4096,
                "type": "string"
              },
              "mode": {
                "minimum": 0,
                "maximum": 4095,
                "type": "integer"
              },
              "size": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "content_sha256": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "real_path",
              "mode",
              "size",
              "content_sha256"
            ]
          }
        },
        "content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "entries",
        "content_sha256"
      ]
    },
    "baseline_runtime_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "lock_diagnostic_content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_scope_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "workflow_owned_delta_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "changed_paths": {
      "maxItems": 100000,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 4096,
        "type": "string"
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "source",
    "source_content_sha256",
    "prior_token_content_sha256",
    "run_id",
    "repository_identity_content_sha256",
    "worktree_key",
    "branch",
    "head",
    "worktree_list_sha256",
    "git_fingerprint",
    "instruction_fingerprint",
    "authority_fingerprint",
    "baseline_runtime_content_sha256",
    "lock_diagnostic_content_sha256",
    "task_scope_identity",
    "workflow_owned_delta_sha256",
    "changed_paths"
  ]
}
