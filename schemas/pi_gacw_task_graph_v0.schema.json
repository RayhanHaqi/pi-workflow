{
  "$id": "https://pi-gacw.invalid/schemas/pi_gacw_task_graph_v0.schema.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "pi_gacw_task_graph_v0",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "content_projection_id": {
      "const": "document-content-v1",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_graph_projection_id": {
      "const": "task-graph-freeze-v1",
      "type": "string"
    },
    "task_graph_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "task_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "task_sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "topological_rank": {
            "minimum": 0,
            "maximum": 1000000,
            "type": "integer"
          },
          "priority": {
            "minimum": -1000000,
            "maximum": 1000000,
            "type": "integer"
          },
          "dependencies": {
            "uniqueItems": true,
            "maxItems": 8,
            "type": "array",
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          },
          "editable_paths": {
            "uniqueItems": true,
            "maxItems": 10000,
            "type": "array",
            "items": {
              "minLength": 1,
              "maxLength": 4096,
              "type": "string"
            }
          },
          "write_owner": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "task_sha256",
          "topological_rank",
          "priority",
          "dependencies",
          "editable_paths",
          "write_owner"
        ]
      }
    },
    "edges": {
      "maxItems": 56,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "from": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "to": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "configured_max_leaves": {
      "minimum": 1,
      "maximum": 8,
      "type": "integer"
    },
    "write_ownership": {
      "const": "ONE_ACTIVE_WRITER",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "content_projection_id",
    "content_sha256",
    "task_graph_projection_id",
    "task_graph_sha256",
    "tasks",
    "edges",
    "configured_max_leaves",
    "write_ownership"
  ]
}
