{
  "name": "pi-bounded-coding-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic M1-M5 kernel with durable repository authority, scoped tools, and bounded control decisions",
  "type": "module",
  "bin": {
    "pi-workflow": "dist/src/cli/pi-workflow.js"
  },
  "pi": {
    "extensions": ["./dist/src/pi-extension/workflow.js"]
  },
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "schema:emit": "tsx src/schemas/emit.ts",
    "schema:check": "tsx src/schemas/emit.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "npm run schema:check && tsc -p tsconfig.json && chmod 755 dist/src/cli/pi-workflow.js"
  },
  "exports": {
    "./canonical-json": "./dist/src/canonical-json/index.js",
    "./control": "./dist/src/control/index.js",
    "./identity": "./dist/src/identity/index.js",
    "./persistence": "./dist/src/persistence/index.js",
    "./repository": "./dist/src/repository/index.js",
    "./schemas": "./dist/src/schemas/index.js",
    "./secure-fs": "./dist/src/secure-fs/index.js",
    "./scoped-tools": "./dist/src/scoped-tools/index.js",
    "./state-machine": "./dist/src/state-machine/index.js"
  },
  "files": [
    "dist/src",
    "helpers",
    "schemas",
    "docs/architecture",
    "README.md"
  ],
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
